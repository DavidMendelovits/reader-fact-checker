{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // *.check.ts files run directly under node --experimental-strip-types, which
    // resolves the real extension rather than a bundler's guess
    "allowImportingTsExtensions": true
  },
  "include": ["src", "api", "vite.config.ts"]
}
