{
  "expo": {
    "name": "Reader Out Loud",
    "slug": "reader-fact-checker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mendelovits.readeroutloud",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "NSSpeechRecognitionUsageDescription": "Your speech is transcribed so the reading agent can respond to it.",
        "NSMicrophoneUsageDescription": "The mic stays live while it reads so you can talk over the narration.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "LS2MX383L8"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mendelovits.readeroutloud",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "The mic stays live while it reads so you can talk over the narration.",
          "speechRecognitionPermission": "Your speech is transcribed so the reading agent can respond to it."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "25804f16-8f93-4c1c-8cef-354d0d680d3f"
      }
    },
    "owner": "dfordavey"
  }
}
