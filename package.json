{
  "name": "reader-fact-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "node --experimental-strip-types src/lib/voice.check.ts && node --experimental-strip-types src/lib/maplimit.check.ts && node --experimental-strip-types src/lib/sentences.check.ts && node --experimental-strip-types --import ./scripts/resolve-ts.mjs api/tts.check.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@mozilla/readability": "^0.5.0",
    "@vercel/analytics": "^2.0.1",
    "epubjs": "^0.3.93",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "voice-glow": "^0.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
