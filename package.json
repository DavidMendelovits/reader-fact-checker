{
  "name": "reader-fact-checker",
  "private": true,
  "version": "0.2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit -p . && vitest run",
    "test": "vitest",
    "dev:e2e": "vite --mode e2e",
    "preview": "vite preview",
    "replay": "vitest run --config test/replay/vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@mozilla/readability": "^0.5.0",
    "@vercel/analytics": "^2.0.1",
    "epubjs": "^0.3.93",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
