# Copy to .env.local. These are read SERVER-SIDE only (Vite dev middleware / Vercel
# functions) — they are never bundled into the browser.
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
OPENAI_API_KEY=sk-...

# Optional. With this set, /api/tts uses Unreal Speech (hosted Kokoro) instead of
# OpenAI; leave it out and the voice stays on gpt-4o-mini-tts. TTS_PROVIDER=openai
# forces OpenAI even when the key is present. UNREAL_SPEECH_VOICE picks the voice.
UNREAL_SPEECH_API_KEY=
# TTS_PROVIDER=unreal
# UNREAL_SPEECH_VOICE=Sierra

# Optional. With this set, /api/navigate answers "open the Hemingway one", "skip
# to chapter three", "archive that", "hold on" with a typed decision from
# TypeSafe's Jev in about a tenth of a second, and the apps act on it without a
# conversation turn. Leave it out and every request goes to the conversation
# model as before. DECIDER_PROVIDER=none switches it off with the key in place.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
