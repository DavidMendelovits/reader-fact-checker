# Copy to .env.local. These are read SERVER-SIDE only (Vite dev middleware / Vercel
# functions) — they are never bundled into the browser.
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
OPENAI_API_KEY=sk-...

# Optional. With this set, /api/tts uses Unreal Speech (hosted Kokoro) instead of
# OpenAI; leave it out and the voice stays on gpt-4o-mini-tts. TTS_PROVIDER=openai
# forces OpenAI even when the key is present. UNREAL_SPEECH_VOICE picks the voice.
UNREAL_SPEECH_API_KEY=
# TTS_PROVIDER=unreal
# UNREAL_SPEECH_VOICE=Sierra

# Optional. With both set, /api/tts uses ElevenLabs (Eleven v4 Turbo), ahead of
# Unreal Speech and OpenAI. The voice id is the one shown for a voice in the
# ElevenLabs voice library. ELEVENLABS_MODEL overrides the model.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4_turbo

# Optional. With this set, the web app streams the mic to Deepgram Flux for speech
# input instead of Chrome's recognizer, on a short-lived token from /api/listen.
# LISTEN_PROVIDER=none switches it off with the key in place; DEEPGRAM_MODEL
# overrides flux-general-en.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=flux-general-en

# Optional. With this set, /api/navigate answers "open the Hemingway one", "skip
# to chapter three", "archive that", "hold on" with a typed decision from
# TypeSafe's Jev in about a tenth of a second, and the apps act on it without a
# conversation turn. Leave it out and every request goes to the conversation
# model as before. DECIDER_PROVIDER=none switches it off with the key in place.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Optional, and worth setting on a deployment. With this set, every /api route
# asks for it as the x-app-token header: the web app asks once and keeps it in
# the browser, the phone takes it in Settings. Leave it out and the routes are
# open to anyone with the URL.
# APP_TOKEN=
