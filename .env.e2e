# The end-to-end test environment: `npm run dev:e2e` (vite --mode e2e) loads this
# over .env.local, so every server port runs on its fake (api/_lib/adapters/fake.ts).
# No keys are used and nothing leaves the machine. Not a product mode: unit and
# integration tests mock each port directly instead.
AGENT_PROVIDER=fake
CLAIMS_PROVIDER=fake
FACTCHECK_PROVIDER=fake
TTS_PROVIDER=fake
DECIDER_PROVIDER=none
LIBRARY_PROVIDER=fake
LISTEN_PROVIDER=none
