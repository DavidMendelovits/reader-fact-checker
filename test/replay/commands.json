  { "say": "what's this chapter called", "expect": [{ "words": true }] },
  { "say": "what does paraffin mean", "expect": [{ "words": true }] },
  { "say": "who wrote the note above the stove", "expect": [{ "words": true }] },
  { "say": "summarize chapter one", "expect": [{ "words": true }] },
  { "say": "what year does the book say the lighthouse was built", "expect": [{ "words": true }] },
  { "say": "wait, what did she just say?", "expect": [{ "words": true }] },
