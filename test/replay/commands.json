[
  { "say": "start reading", "expect": [{ "tool": "read_aloud" }] },
  { "say": "keep going", "expect": [{ "tool": "read_aloud" }] },
  { "say": "read from the beginning", "expect": [{ "tool": "read_aloud", "args": { "from": 0 } }] },
  { "say": "go to chapter two", "expect": [{ "tool": "read_aloud", "args": { "from": 5 } }] },
  { "say": "skip to the last chapter", "expect": [{ "tool": "read_aloud", "args": { "from": 9 } }] },
  { "say": "start chapter three", "expect": [{ "tool": "read_aloud", "args": { "from": 9 } }] },
  { "say": "go back a paragraph", "expect": [{ "tool": "read_aloud", "args": { "from": 3 } }] },
  { "say": "read that paragraph again", "expect": [{ "tool": "read_aloud", "args": { "from": 4 } }] },
  { "say": "skip this paragraph", "expect": [{ "tool": "read_aloud", "args": { "from": 5 } }] },
  { "say": "read from paragraph eight", "expect": [{ "tool": "read_aloud", "args": { "from": 8 } }] },
  { "say": "read the next two paragraphs", "expect": [{ "tool": "read_aloud", "args": { "from": 5, "to": 6 } }] },
  { "say": "read just chapter one", "expect": [{ "tool": "read_aloud", "args": { "from": 0, "to": 4 } }] },
  { "say": "jump to the part about the storm", "expect": [{ "tool": "read_aloud", "args": { "from": 7 } }, { "tool": "find_in_document", "args": { "query": { "re": "storm|railing" } } }] },
  { "say": "go back to where she relights the lamp", "expect": [{ "tool": "read_aloud", "args": { "from": 7 } }, { "tool": "find_in_document", "args": { "query": { "re": "relight|lamp" } } }] },
  { "say": "find where she talks about the radio", "expect": [{ "tool": "find_in_document", "args": { "query": "radio" } }, { "tool": "read_aloud", "args": { "from": 5 } }] },
  { "say": "faster", "expect": [{ "tool": "set_speed", "args": { "rate": { "gt": 1 } } }] },
  { "say": "slow down a bit", "expect": [{ "tool": "set_speed", "args": { "rate": { "lt": 1 } } }] },
  { "say": "normal speed", "expect": [{ "tool": "set_speed", "args": { "rate": 1 } }] },
  { "say": "set the speed to one and a half", "expect": [{ "tool": "set_speed", "args": { "rate": 1.5 } }] },
  { "say": "double speed please", "expect": [{ "tool": "set_speed", "args": { "rate": 2 } }] },
  { "say": "speed up and keep reading", "expect": [{ "tool": "set_speed", "args": { "rate": { "gt": 1 } } }] },
  { "say": "is that true about South Foreland?", "expect": [{ "tool": "fact_check", "args": { "claim": "South Foreland" } }] },
  { "say": "was the first electric lighthouse really lit in 1858?", "expect": [{ "tool": "fact_check", "args": { "claim": "1858" } }] },
  { "say": "can a lighthouse beam really reach twenty miles?", "expect": [{ "tool": "fact_check", "args": { "claim": { "re": "twenty|20" } } }] },
  { "say": "how far can a lighthouse actually be seen?", "expect": [{ "tool": "fact_check" }] },
  { "say": "fact check the bit about paraffin", "expect": [{ "tool": "fact_check", "args": { "claim": { "re": "paraffin|1874" } } }] },
  { "say": "highlight that", "expect": [{ "tool": "highlight", "args": { "text": "wind the clockwork" } }] },
  { "say": "highlight that and note: use this in my talk", "expect": [{ "tool": "highlight", "args": { "text": "wind the clockwork", "note": "talk" } }] },
  { "say": "save the note about the stove", "expect": [{ "tool": "highlight", "args": { "text": "the cook is worse than you fear" } }] },
  { "say": "highlight the last line of the book", "expect": [{ "tool": "highlight", "args": { "text": "a habit is just a promise" } }] },
  { "say": "highlight the bit about missing the weather", "expect": [{ "tool": "highlight", "args": { "text": "Nobody writes it down for a machine" } }] },
  { "say": "highlight wind the clockwork and polish the lens, but skip the rest of that sentence", "expect": [{ "tool": "highlight", "args": { "parts": { "any": true } } }] },
  { "say": "switch to Notes on Sleep", "expect": [{ "tool": "search_library", "args": { "query": "sleep" } }] },
  { "say": "open The Long Storm", "expect": [{ "tool": "search_library", "args": { "query": "storm" } }] },
  { "say": "open my book about the long storm and start chapter two", "expect": [{ "tool": "search_library", "args": { "query": "storm" } }] },
  { "say": "what should I read next", "expect": [{ "tool": "recommend" }] },
  { "say": "recommend something short", "expect": [{ "tool": "recommend" }] },
  { "say": "start reading something new", "expect": [{ "tool": "recommend" }, { "tool": "search_library" }] },
  { "say": "find my highlights about naps", "expect": [{ "tool": "search_highlights", "args": { "query": { "re": "nap|sleep" } } }] },
  { "say": "what have I highlighted about storms", "expect": [{ "tool": "search_highlights", "args": { "query": "storm" } }] },
  { "say": "do I have anything saved about sleep", "expect": [{ "tool": "search_highlights" }, { "tool": "search_library" }] },
